# Copiez ce fichier en .env et ajustez les valeurs selon votre environnement.
# .env n'est jamais versionne (voir .gitignore) : c'est le fichier reel utilise
# en local/production. .env.example sert de documentation et de modele.

# ---------------------------------------------------------------
# Chemins des artefacts (relatifs a app/, voir app/config.py)
# ---------------------------------------------------------------
MODEL_PATH=../models/simple_cnn_model.h5
METRICS_PATH=../results/metrics.json
REPORT_OUTPUT=../results/reports
HISTORY_DB_PATH=../results/history.db

# ---------------------------------------------------------------
# Application
# ---------------------------------------------------------------
APP_TITLE=AI Radiology Analyzer
APP_VERSION=1.0.0
DEFAULT_LANGUAGE=fr
DEFAULT_THEME=light
DEFAULT_GRADCAM_ALPHA=0.5
MAX_UPLOAD_SIZE_MB=10

# ---------------------------------------------------------------
# Fonctionnalites (activer/desactiver sans toucher au code)
# ---------------------------------------------------------------
ENABLE_ASSISTANT=true
ENABLE_HISTORY=true
ENABLE_PDF_EXPORT=true
ENABLE_JSON_EXPORT=true

# ---------------------------------------------------------------
# Assistant IA — backend Ollama local (RAG hybride, app/assistant/)
# Aucune cle API payante : Ollama tourne en local, le modele est
# telecharge une fois puis fonctionne hors-ligne. Installer Ollama
# (https://ollama.com), lancer `ollama serve`, puis
# `ollama pull qwen3:8b` (ou le modele choisi ci-dessous).
# ---------------------------------------------------------------
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
